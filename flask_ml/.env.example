# Salin file ini menjadi .env
# cp .env.example .env

# ── MongoDB ───────────────────────────────────────────────────────
# Lokal
MONGO_URI=mongodb://localhost:27017/

# MongoDB Atlas (cloud) — ganti username, password, cluster
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/

DB_NAME=monitoring_harga_pangan

# ── Flask ─────────────────────────────────────────────────────────
# Ganti dengan string acak panjang di production!
SECRET_KEY=ganti_ini_dengan_random_string_panjang
